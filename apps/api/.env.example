# API runtime environment. Copy to apps/api/.env (auto-loaded by Bun).

# PostgreSQL connection (dev default matches docker-compose.yml on host port 5434).
DATABASE_URL="postgresql://batool:batool@127.0.0.1:5434/batool"

# NestJS listen port (default 4000).
API_PORT=4000

# Exact frontend origin; used for CORS (credentials).
WEB_ORIGIN="http://localhost:3000"

# Set NODE_ENV=production to enable strict runtime behaviour (secure cookies, etc.).
# NODE_ENV=production
