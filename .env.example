# Root template. The API loads apps/api/.env, the Prisma CLI loads
# packages/database/.env, and the web app loads apps/web/.env.local.
# Copy the relevant values, replace placeholders, and never commit real secrets.

# --- docker-compose (Postgres) ---
POSTGRES_DB=batool
POSTGRES_USER=batool
POSTGRES_PASSWORD=batool
POSTGRES_PORT=5434

# --- shared application env (see per-app .env.example files) ---
DATABASE_URL="postgresql://batool:batool@127.0.0.1:5434/batool"
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_ORIGIN="http://localhost:4000/api"
